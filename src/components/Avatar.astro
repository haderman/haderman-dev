---
import { Image } from "astro:assets";
import imgProfileSrc from "@/images/profile.png";
---

<div class="avatar">
  <Image src={imgProfileSrc} alt="profile picture" />
</div>

<style>
  .avatar {
    position: relative;
    --size: var(--fluid-3);
    grid-area: avatar;
    position: relative;
    overflow: hidden;
    width: 100%;
    height: 100%;

    img {
      height: 100%;
      filter: grayscale(1);
      position: relative;
      object-fit: cover;
    }
  }
</style>
