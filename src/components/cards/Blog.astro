---
import BlogPost from "@/components/cards/BlogPost.astro";
import type { BlogPost as BlogPostEntry } from "@/data/blog";

interface Props {
  latest: BlogPostEntry;
  featured: BlogPostEntry[];
}

const { latest, featured } = Astro.props;
---

<section
  data-area="blog"
  class="card blog"
  aria-labelledby="blog-heading"
  style={`--blog-count: ${featured.length + 1}`}
>
  <header class="blog-header">
    <div class="blog-heading">
      <p class="eyebrow">Writing</p>
      <h2 id="blog-heading">Notes, experiments, and things I’m learning.</h2>
    </div>
    <a class="all-posts" href="/blog">
      View all posts <span aria-hidden="true">→</span>
    </a>
  </header>

  <div class="blog-posts">
    <BlogPost post={latest} label="Latest" latest />
    {
      featured.map((post) => (
        <BlogPost post={post} label="Featured" />
      ))
    }
  </div>
</section>

<style>
  .card.blog {
    align-items: stretch;
    flex-direction: column;
    gap: var(--fluid-2);
    padding: var(--fluid-1) 0;
  }

  .blog-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--fluid-1);
  }

  .blog-heading {
    display: grid;
    gap: var(--fluid--2);
  }

  .eyebrow {
    color: var(--accent-color);
    font-size: var(--fluid--1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h2 {
    font-size: var(--fluid-3);
    text-align: left;
  }

  .all-posts {
    display: inline-flex;
    align-items: center;
    gap: var(--fluid--2);
    padding: var(--fluid--1) var(--fluid-0);
    border: 1px solid transparent;
    background: var(--accent-special);
    color: var(--accent-color);
    white-space: nowrap;
  }

  .all-posts:hover {
    background: var(--accent-special-hover);
    text-decoration: none;
  }

  .blog-posts {
    display: grid;
    grid-template-columns: 1fr;
    min-width: 0;
    gap: var(--fluid-1);
  }

  @media screen and (min-width: 768px) {
    .blog-header {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }

    .blog-posts {
      grid-template-columns: repeat(
        var(--blog-count, 1),
        minmax(0, 1fr)
      );
    }
  }
</style>