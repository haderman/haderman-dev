---
import {
  formatBlogAuthorship,
  formatBlogDate,
  getBlogSlug,
  type BlogPost as BlogPostEntry,
} from "@/data/blog";

interface Props {
  post: BlogPostEntry;
  label?: string;
  latest?: boolean;
}

const { post, label = "Featured", latest = false } = Astro.props;
const href = `/blog/${getBlogSlug(post)}`;
const publishedAt = post.data.publishDate.toISOString();
---

<a
  class:list={["post-card", "special-bg", { latest }]}
  href={href}
>
  <div class="post-labels">
    <span class="post-label">{label}</span>
    <span class="post-authorship">
      {formatBlogAuthorship(post.data.authorship)}
    </span>
  </div>
  <h3>{post.data.title}</h3>
  <p>{post.data.description}</p>
  <span class="post-meta">
    <time datetime={publishedAt}>{formatBlogDate(post.data.publishDate)}</time>
    {
      post.data.tags.length > 0 && (
        <>
          <span aria-hidden="true">·</span>
          <span>{post.data.tags.slice(0, 2).join(" · ")}</span>
        </>
      )
    }
  </span>
</a>

<style>
  .post-card {
    display: flex;
    min-width: 0;
    min-height: 12rem;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--fluid--1);
    padding: var(--fluid-1);
    border: 1px solid transparent;
    color: var(--primary-text);
    text-decoration: none;
    transition:
      background 0.2s ease-in-out,
      border-color 0.2s ease-in-out;
  }

  .post-card:hover {
    border-color: var(--accent-color);
    background: var(--accent-special-hover);
    text-decoration: none;
  }

  .post-labels {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--fluid--2);
  }

  .post-label {
    color: var(--accent-color);
    font-size: var(--fluid--1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .post-authorship {
    color: var(--secondary-text);
    font-size: var(--fluid--1);
  }

  h3 {
    font-size: var(--fluid-2);
    text-align: left;
    text-wrap: balance;
  }

  p {
    color: var(--secondary-text);
    font-size: var(--fluid-0);
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--fluid--2);
    margin-top: auto;
    color: var(--secondary-text);
    font-size: var(--fluid--1);
  }

</style>