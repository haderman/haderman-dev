---
import { Image } from "astro:assets";

import Chips from "@/components/Chips.astro";
import externalLinkSVG from "@/icons/external-link.svg?raw";

type Props = {
  name: string;
  title: string;
  description: string;
  imgSrc: ImageMetadata | string;
  href: string;
  stack: Array<string>;
  external?: boolean;
};

const {
  name,
  title,
  description,
  imgSrc,
  stack,
  href,
  external = false,
} = Astro.props;

const ariaLabelledby = `project-${name}-heading`;
const imgAlt = `Project ${title}`;
const dataArea = `project-${name.toLocaleLowerCase()}`;
---

<article data-area={dataArea} class="card project special-bg">
  <div class="project-image">
    {
      typeof imgSrc === "string" ? (
        <img src={imgSrc} alt={imgAlt} />
      ) : (
        <Image src={imgSrc} alt={imgAlt} />
      )
    }
  </div>
  <div class="project-content">
    <h2 id={ariaLabelledby}>
      <a
        href={href}
        aria-labelledby={ariaLabelledby}
        target={external ? "_blank" : undefined}
        rel={external ? "noreferrer" : undefined}
      >
        <span>{title}</span>
        {external && <Fragment set:html={externalLinkSVG} />}
      </a>
    </h2>
    <p>{description}</p>
    <Chips values={stack} />
  </div>
</article>

<style>
  .card.project {
    gap: var(--fluid-2);
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;

    .project-image {
      flex: 0 0 auto;
      width: 100%;
      aspect-ratio: 16 / 9;
      overflow: hidden;

      img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
      }
    }

    .project-content {
      position: relative;
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--fluid-0);
    }

    .project-content::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      transform: translateY(-90%);
      width: 100%;
      height: var(--fluid-4);
      background: linear-gradient(
        to top,
        lch(0 0 0 / 0.9) 0%,
        lch(0 0 0 / 0) 90%
      );
      z-index: 0;
    }

    h2 {
      font-size: var(--fluid-1);
      text-align: left;

      a {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: var(--fluid--1);
      }
      svg {
        --size: var(--fluid-2);
        width: var(--size);
        height: var(--size);
      }
    }

    :where(h2, p) {
      text-shadow: 1px 1px 1px rgba(0, 0, 0, 0.5);
    }

    @media screen and (min-width: 1024px) {
      .project-image img {
        filter: grayscale(1);
      }

      &:hover .project-image img {
        filter: grayscale(0);
      }
    }
  }
</style>