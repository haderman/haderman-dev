---
import "@fontsource-variable/montserrat";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Haderman" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script type="text/partytown" is:inline>
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "sdzn5jo70k");
    </script>
  </body>
</html>
<style is:global></style>

<script>
  import { logger } from "@/lib/logger";
  import { settings } from "@/store/settings";

  document.addEventListener("DOMContentLoaded", () => {
    configLogger();
    configTheming();
  });

  function configLogger() {
    console.log("configuring logger");
    logger({
      type: "pageview",
      href: "home",
    });

    document.body.addEventListener("click", (e) => {
      const target = (e.target as HTMLElement).closest("a");
      const targetButton = (e.target as HTMLElement).closest("button");

      if (target) {
        logger({
          type: "click",
          href: target.getAttribute("href"),
        });
      }

      if (targetButton) {
        logger({
          type: "button-click",
          buttonId: targetButton.getAttribute("id"), // Assuming buttons have IDs
          buttonText: targetButton.textContent,
        });
      }
    });
  }

  function configTheming() {
    settings.subscribe((state) => {
      const $html = document.querySelector("html");
      $html.setAttribute("data-theme", state.theme);
    });
  }
</script>
