---
import Layout from '@/layouts/Layout.astro';
import "@/styles/root.css";
---

<Layout title="HTML to Markdown Converter - haderman">
  <header class="header-page">
    <a href="/tools" class="back-link">← Back to Tools</a>
  </header>
  
  <main class="converter-container">
    <div class="grid">
      <div class="input-section">
        <h2>HTML Input</h2>
        <textarea id="html-input" class="editor" placeholder="Paste your HTML here..."></textarea>
      </div>
      
      <div class="output-section">
        <div class="output-header">
          <h2>Markdown Output</h2>
          <button id="copy-btn" class="cta-button secondary" aria-label="Copy Markdown">
            📋 Copy
          </button>
        </div>
        <pre id="markdown-output" class="editor"></pre>
      </div>
    </div>
    
    <div class="actions">
      <button id="convert-btn" class="cta-button primary">
        <span class="btn-text">Convert to Markdown</span>
        <span class="loading-dots" aria-hidden="true"></span>
      </button>
    </div>
  </main>

  <footer>
    <!-- Optional footer content -->
  </footer>
</Layout>

<style is:global>
  .converter-container {
    padding: var(--fluid-3);
    max-width: 1200px;
    margin: 0 auto;
  }

  .header-page {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--fluid-2) var(--fluid-3);
  }

  .back-link {
    font-size: var(--fluid-1);
    color: var(--accent-color);
  }

  .grid {
    display: grid;
    gap: var(--fluid-3);
    grid-template-columns: 1fr;
  }

  .editor {
    width: 100%;
    height: 400px;
    padding: var(--fluid-2);
    border: 1px solid var(--color-cyan);
    border-radius: 8px;
    background: var(--special-bg-cyan);
    font-family: monospace;
    font-size: var(--fluid-1);
    line-height: 1.5;
  }

  .output-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--fluid-1);
  }

  .cta-button {
    padding: var(--fluid-2) var(--fluid-3);
    border: none;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: var(--fluid-0);
  }

  .primary {
    background: var(--color-cyan);
    color: var(--primary-color);
  }

  .secondary {
    background: var(--special-bg-cyan);
    color: var(--color-cyan);
    border: 1px solid var(--color-cyan);
  }

  .cta-button:hover {
    opacity: 0.9;
  }

  .cta-button:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .loading-dots::after {
    content: '.';
    animation: dots 1.5s infinite;
  }

  @keyframes dots {
    0%, 20% { content: '.'; }
    40% { content: '..'; }
    60% { content: '...'; }
    80%, 100% { content: ''; }
  }

  @media (min-width: 768px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

<script>
  import TurndownService from 'turndown';

  document.addEventListener('DOMContentLoaded', () => {
    const turndownService = new TurndownService({
      codeBlockStyle: 'fenced',
      headingStyle: 'atx',
      bulletListMarker: '-',
      hr: '---',
      emDelimiter: '*',
      strongDelimiter: '**'
    });

    turndownService.addRule('code', {
      filter: ['pre'],
      replacement: (content, node) => {
        const codeBlock = node.querySelector('code');
        const language = codeBlock?.className?.match(/language-(\w+)/)?.[1] || '';
        return `\`\`\`${language}\n${content}\n\`\`\`\n\n`;
      }
    });

    const convertBtn = document.getElementById('convert-btn');
    const copyBtn = document.getElementById('copy-btn') as HTMLButtonElement | null;
    const htmlInput = document.getElementById('html-input') as HTMLTextAreaElement;
    const markdownOutput = document.getElementById('markdown-output') as HTMLPreElement & { readOnly: boolean };

    if (!htmlInput || !markdownOutput || !convertBtn || !copyBtn) {
      throw new Error('Required elements missing from DOM');
    }

    async function handleConversion() {
      try {
        convertBtn?.toggleAttribute('disabled', true);
        convertBtn.querySelector('.btn-text').textContent = 'Converting';
        
        const html = htmlInput.value;
        const markdown = turndownService.turndown(html);
        markdownOutput.textContent = markdown;
        
        copyBtn?.toggleAttribute('disabled', false);
      } catch (error) {
        alert('Conversion failed. Please check your HTML input.');
        console.error('Conversion error:', error);
      } finally {
        convertBtn?.toggleAttribute('disabled', false);
        convertBtn.querySelector('.btn-text').textContent = 'Convert to Markdown';
        copyBtn?.toggleAttribute('disabled', true);
      }
    }

    async function handleCopy() {
      try {
        await navigator.clipboard.writeText(markdownOutput.textContent);
        if (copyBtn) copyBtn.textContent = '✅ Copied!';
        setTimeout(() => {
          if (copyBtn) copyBtn.textContent = '📋 Copy';
        }, 2000);
      } catch (err) {
        if (copyBtn) copyBtn.textContent = '❌ Failed';
        setTimeout(() => {
          if (copyBtn) copyBtn.textContent = '📋 Copy';
        }, 2000);
      }
    }

    convertBtn.addEventListener('click', handleConversion);
    if (copyBtn) copyBtn.addEventListener('click', handleCopy);
  });
</script>
<script src="https://cdn.jsdelivr.net/npm/turndown@7.1.1/dist/turndown.umd.js"></script>
